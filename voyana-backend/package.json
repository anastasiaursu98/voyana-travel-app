{
  "name": "voyana-backend",
  "version": "1.0.0",
  "description": "Voyana travel booking backend API",
  "license": "ISC",
  "author": "Anastasia Ursu",
  "type": "commonjs",
  "main": "dist/index.js",
  "scripts": {
    "test": "jest",
    "test:watch": "jest --watch",
    "dev": "ts-node-dev --respawn --transpile-only src/index.ts",
    "seed:destinations": "ts-node-dev --transpile-only src/scripts/seedDestinations.ts",
    "seed:vacation-categories": "ts-node-dev --transpile-only src/scripts/seedVacationCategories.ts",
    "seed:vacation-packages": "ts-node-dev --transpile-only src/scripts/seedVacationPackages.ts",
    "seed:travel-data": "npm run seed:destinations && npm run seed:vacation-packages",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js"
  },
  "keywords": [],
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-session": "^1.19.0",
    "jsonwebtoken": "^9.0.3",
    "mailtrap": "^4.6.0",
    "mongodb": "^7.3.0",
    "mongoose": "^9.7.0",
    "nodemailer": "^8.0.11"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^25.9.2",
    "@types/nodemailer": "^6.4.24",
    "@types/supertest": "^7.2.0",
    "jest": "^30.4.2",
    "mongodb-memory-server": "^11.2.0",
    "supertest": "^7.2.2",
    "ts-jest": "^29.4.11",
    "ts-node-dev": "^2.0.0",
    "typescript": "^6.0.3"
  }
}
